# SciForge web app: example Streamlit secrets file (PLACEHOLDERS ONLY).
#
# Copy to .streamlit/secrets.toml (gitignored) for local use, or paste the
# lines into the "Secrets" box of your Streamlit Community Cloud app settings.
# NEVER commit a real key. Environment variables with the same names take
# precedence over these values.
#
# Live Mode deployment gate (default false): Live Mode is enabled only when
# SCIFORGE_LIVE_ENABLED is exactly "true" (quoted string, case-insensitive)
# AND both XAI_API_KEY and XAI_MODEL are set. Any other value (including an
# unquoted TOML boolean) keeps Live Mode disabled. Live Mode has not yet been
# validated against the real xAI API.

SCIFORGE_LIVE_ENABLED = "false"
XAI_API_KEY = "replace-with-your-xai-api-key"
XAI_MODEL = "replace-with-an-xai-model-name"

# Sign-in for Live Mode (default true). ONLY the exact string "false" disables it;
# anything else (unset, "no", "0", an unquoted TOML boolean) means sign-in is
# required. With sign-in required, Live Mode also needs the [auth] section at the
# end of this file (Streamlit native OIDC; requires the Authlib package) and an
# allowlisted email. Demo Mode never needs sign-in.
SCIFORGE_LIVE_REQUIRE_AUTH = "true"
# Comma-separated allowlist (or a TOML list of strings); case-insensitive exact
# match on the signed-in email. Empty = nobody may use Live Mode (fail closed).
SCIFORGE_LIVE_ALLOWED_EMAILS = "person1@example.org, person2@example.org"

# Emergency off switch: unset/empty/"false" = off; any other value = Live Mode unavailable.
# SCIFORGE_LIVE_KILL_SWITCH = "false"
# Per-user limit (Live runs per rolling 24 h, 1-1000; default 3), quota store path (absolute; default
# ~/.local/state/sciforge/live_quota.json) and optional HMAC secret for the stored email hash.
# SCIFORGE_LIVE_MAX_RUNS_PER_USER = "3"
# SCIFORGE_LIVE_QUOTA_PATH = "/var/lib/sciforge/live_quota.json"
# SCIFORGE_LIVE_QUOTA_SALT = "replace-with-a-long-random-string"
# Quota backend: "file" (default) or "postgres" (needs the [connections.sciforge_quota] section below and
# deploy/sql/001_live_quota.sql applied; required on hosts without a persistent filesystem).
# SCIFORGE_LIVE_QUOTA_BACKEND = "postgres"
# SCIFORGE_LIVE_QUOTA_CONNECTION = "sciforge_quota"

# Other SciForge settings (spend cap, prices, budgets) are read from environment
# variables only; see .env.example. The web app's Live Mode uses a $2 spend cap when
# SCIFORGE_MAX_SPEND_USD is unset. With the default spend cap you must set
# SCIFORGE_PRICE_INPUT_PER_MTOK and SCIFORGE_PRICE_OUTPUT_PER_MTOK (or
# SCIFORGE_MAX_SPEND_USD=none) or Live Mode refuses to start. On Streamlit
# Community Cloud, root-level secrets are also exported as environment
# variables, so they can be added here as well.
#
# Optional model/retrieval tuning (placeholders = documented recommendations; uncomment to use).
# Defaults when unset: input-token budget 200000, global output cap 2000 per call, reasoning effort "high",
# candidate pool 10 records per query and database. Invalid values make Live Mode refuse to start.
# SCIFORGE_MODEL_MAX_INPUT_TOKENS = "200000"
# SCIFORGE_MODEL_MAX_OUTPUT_TOKENS = "2000"
# SCIFORGE_MODEL_MAX_OUTPUT_TOKENS_QUESTION = "2000"
# SCIFORGE_MODEL_MAX_OUTPUT_TOKENS_EVIDENCE = "2000"
# SCIFORGE_MODEL_MAX_OUTPUT_TOKENS_GAPS = "4000"
# SCIFORGE_MODEL_MAX_OUTPUT_TOKENS_HYPOTHESES = "8000"
# SCIFORGE_MODEL_MAX_OUTPUT_TOKENS_HYPOTHESIS_CRITIC = "4000"
# SCIFORGE_MODEL_MAX_OUTPUT_TOKENS_HYPOTHESIS_REVISION = "4000"
# SCIFORGE_MODEL_MAX_OUTPUT_TOKENS_REPORT = "4000"
# SCIFORGE_MODEL_REASONING_EFFORT = "high"
# SCIFORGE_MODEL_REASONING_EFFORT_EVIDENCE = "medium"
# SCIFORGE_MODEL_REASONING_EFFORT_GAPS = "medium"
# SCIFORGE_MODEL_REASONING_EFFORT_HYPOTHESES = "high"
# SCIFORGE_MODEL_REASONING_EFFORT_HYPOTHESIS_CRITIC = "high"
# SCIFORGE_MODEL_REASONING_EFFORT_HYPOTHESIS_REVISION = "medium"
# SCIFORGE_MODEL_REASONING_EFFORT_REPORT = "medium"
# SCIFORGE_CANDIDATE_POOL_PER_QUERY = "10"
# SCIFORGE_ABSTRACT_ENRICHMENT_LIMIT = "50"
# SCIFORGE_SOURCE_POLICY = "peer_reviewed_preferred"

# Streamlit native OIDC login (st.login / st.user), used for Live Mode sign-in.
# TOML tables must come after all root-level keys, so keep this section last.
# All five keys are required; placeholders only. Register redirect_uri with your
# identity provider (e.g. https://<your-app>.streamlit.app/oauth2callback, or
# http://localhost:8501/oauth2callback locally). cookie_secret: a long random string.
[auth]
redirect_uri = "https://replace-with-your-app-url/oauth2callback"
cookie_secret = "replace-with-a-long-random-string"
client_id = "replace-with-your-oidc-client-id"
client_secret = "replace-with-your-oidc-client-secret"
server_metadata_url = "https://replace-with-your-provider/.well-known/openid-configuration"

# PostgreSQL connection for SCIFORGE_LIVE_QUOTA_BACKEND = "postgres" (Streamlit st.connection, type="sql").
# Placeholders only. Use EITHER url OR the individual fields. Keep it after all root-level keys.
# [connections.sciforge_quota]
# url = "postgresql+psycopg://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>?sslmode=require"
# -- or --
# dialect = "postgresql"
# driver = "psycopg"
# host = "<DB_HOST>"
# port = 5432
# database = "<DB_NAME>"
# username = "<DB_USER>"
# password = "<DB_PASSWORD>"
# query = { sslmode = "require" }
