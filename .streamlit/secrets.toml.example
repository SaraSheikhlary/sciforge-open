# SciForge web app: example Streamlit secrets file (PLACEHOLDERS ONLY).
#
# Copy to .streamlit/secrets.toml (gitignored) for local use, or paste the
# lines into the "Secrets" box of your Streamlit Community Cloud app settings.
# NEVER commit a real key. Environment variables with the same names take
# precedence over these values.
#
# Live Mode deployment gate (default false): Live Mode is enabled only when
# SCIFORGE_LIVE_ENABLED is exactly "true" (quoted string, case-insensitive)
# AND both XAI_API_KEY and XAI_MODEL are set. Any other value (including an
# unquoted TOML boolean) keeps Live Mode disabled. Live Mode has not yet been
# validated against the real xAI API.

SCIFORGE_LIVE_ENABLED = "false"
XAI_API_KEY = "replace-with-your-xai-api-key"
XAI_MODEL = "replace-with-an-xai-model-name"

# Other SciForge settings (spend cap, prices, budgets) are read from environment
# variables only; see .env.example. With the default spend cap you must set
# SCIFORGE_PRICE_INPUT_PER_MTOK and SCIFORGE_PRICE_OUTPUT_PER_MTOK (or
# SCIFORGE_MAX_SPEND_USD=none) or Live Mode refuses to start. On Streamlit
# Community Cloud, root-level secrets are also exported as environment
# variables, so they can be added here as well.
#
# Optional model/retrieval tuning (placeholders = documented recommendations; uncomment to use).
# Defaults when unset: input-token budget 200000, global output cap 2000 per call, reasoning effort "high",
# candidate pool 10 records per query and database. Invalid values make Live Mode refuse to start.
# SCIFORGE_MODEL_MAX_INPUT_TOKENS = "200000"
# SCIFORGE_MODEL_MAX_OUTPUT_TOKENS = "2000"
# SCIFORGE_MODEL_MAX_OUTPUT_TOKENS_QUESTION = "2000"
# SCIFORGE_MODEL_MAX_OUTPUT_TOKENS_EVIDENCE = "2000"
# SCIFORGE_MODEL_MAX_OUTPUT_TOKENS_GAPS = "4000"
# SCIFORGE_MODEL_MAX_OUTPUT_TOKENS_HYPOTHESES = "8000"
# SCIFORGE_MODEL_MAX_OUTPUT_TOKENS_REPORT = "4000"
# SCIFORGE_MODEL_REASONING_EFFORT = "high"
# SCIFORGE_MODEL_REASONING_EFFORT_EVIDENCE = "medium"
# SCIFORGE_MODEL_REASONING_EFFORT_GAPS = "medium"
# SCIFORGE_MODEL_REASONING_EFFORT_HYPOTHESES = "high"
# SCIFORGE_MODEL_REASONING_EFFORT_REPORT = "medium"
# SCIFORGE_CANDIDATE_POOL_PER_QUERY = "10"
