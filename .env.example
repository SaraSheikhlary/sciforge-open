# SciForge environment variables (example file: placeholders only).
# Copy to .env (which is gitignored) and export the variables before running, e.g.:
#   set -a; source .env; set +a
# SciForge reads configuration from the environment only; it does not load .env itself.

# Optional: NCBI E-utilities API key (raises the PubMed limit from 3 to 10 requests/s).
NCBI_API_KEY=

# Recommended: contact address sent to NCBI (email=) and Crossref (mailto= / User-Agent).
SCIFORGE_CONTACT_EMAIL=

# Optional tuning (defaults shown in comments).
# SCIFORGE_TIMEOUT_SECONDS=20
# SCIFORGE_MAX_RETRIES=2
# SCIFORGE_BACKOFF_SECONDS=1
# Deterministic rule-based query expansion before PubMed/Crossref search (default true, no model).
# false searches with the question verbatim only (same as the CLI flag --no-query-expansion).
# SCIFORGE_QUERY_EXPANSION=true
# Candidate pool: records requested per expanded query and database before deduplication and
# deterministic selection (default 10, integer 1-100; each query requests max(pool, --max-results)).
# SCIFORGE_CANDIDATE_POOL_PER_QUERY=10
# Bounded abstract enrichment before deterministic ranking: at most this many deduplicated candidates
# (chosen deterministically: title pre-score, best search rank, record id) get an abstract via batched
# PubMed efetch or the Crossref abstract field. Default 50, integer 0-500; 0 disables (title-only ranking).
# SCIFORGE_ABSTRACT_ENRICHMENT_LIMIT=50
# Source policy (metadata-based source types): allow_all | peer_reviewed_preferred (default) | peer_reviewed_only.
# peer_reviewed_only keeps only "peer-reviewed journal article" records (preprints, conference papers,
# books/chapters and unknown types are excluded). The label is metadata-based, not a guarantee of peer review.
# Any other value is a configuration error.
# SCIFORGE_SOURCE_POLICY=peer_reviewed_preferred

# ---------------------------------------------------------------------------
# v0.3 model layer (optional). NOT read by the v0.2 retrieval/verification path.
# Only needed once the model layer is enabled (CLI flag arrives in a later milestone).
# Never commit real values; keep them in your untracked .env.

# Required for model runs: xAI API key and model name (no default model is shipped).
# XAI_API_KEY=
# XAI_MODEL=
# Optional: API base URL (https only). Default: https://api.x.ai
# XAI_BASE_URL=

# Per-investigation budgets (defaults shown). Every API attempt counts, including retries.
# SCIFORGE_MODEL_MAX_ATTEMPTS=15
# SCIFORGE_MODEL_MAX_SOURCES=10
# SCIFORGE_MODEL_MAX_INPUT_TOKENS=200000
# Global per-call output setting (fallback for every stage). Sent as max_output_tokens and used for the
# pre-call worst case; NOT a guaranteed ceiling on billed tokens (reasoning tokens may be billed on top).
# SCIFORGE_MAX_SPEND_USD below is the hard financial guard.
# SCIFORGE_MODEL_MAX_OUTPUT_TOKENS=2000
# Optional per-stage output caps (integer 16-128000; blank = use the global cap). Recommended values:
# SCIFORGE_MODEL_MAX_OUTPUT_TOKENS_QUESTION=2000
# SCIFORGE_MODEL_MAX_OUTPUT_TOKENS_EVIDENCE=2000
# SCIFORGE_MODEL_MAX_OUTPUT_TOKENS_GAPS=4000
# SCIFORGE_MODEL_MAX_OUTPUT_TOKENS_HYPOTHESES=8000
# v0.4 hypothesis engine: critic and revision stages (one batched call each)
# SCIFORGE_MODEL_MAX_OUTPUT_TOKENS_HYPOTHESIS_CRITIC=4000
# SCIFORGE_MODEL_MAX_OUTPUT_TOKENS_HYPOTHESIS_REVISION=4000
# SCIFORGE_MODEL_MAX_OUTPUT_TOKENS_REPORT=4000
# Reasoning effort sent to the xAI Responses API: low, medium, high or xhigh (default high).
# The question stage always uses the global value. Invalid values are a configuration error.
# SCIFORGE_MODEL_REASONING_EFFORT=high
# Optional per-stage overrides (blank = use the global value). Recommended values:
# SCIFORGE_MODEL_REASONING_EFFORT_EVIDENCE=medium
# SCIFORGE_MODEL_REASONING_EFFORT_GAPS=medium
# SCIFORGE_MODEL_REASONING_EFFORT_HYPOTHESES=high
# SCIFORGE_MODEL_REASONING_EFFORT_HYPOTHESIS_CRITIC=high
# SCIFORGE_MODEL_REASONING_EFFORT_HYPOTHESIS_REVISION=medium
# SCIFORGE_MODEL_REASONING_EFFORT_REPORT=medium
# Spend cap in USD (default 15) = the hard financial guard. Use "none" to disable the cap explicitly.
# While the cap is enabled, BOTH prices below must be set or model runs refuse to start.
# Default 15 for the CLI/library; the web app's Live Mode uses 2 when this is unset.
# SCIFORGE_MAX_SPEND_USD=15

# Prices in USD per 1M tokens, copied from your xAI console. No prices are shipped.
# SCIFORGE_PRICE_INPUT_PER_MTOK=
# SCIFORGE_PRICE_OUTPUT_PER_MTOK=

# Per-request xAI timeout in seconds (default 120). Positive number up to 600; blank, invalid,
# non-positive, non-finite or >600 values fall back to 120.
# SCIFORGE_MODEL_TIMEOUT_SECONDS=120
# Store full prompts/responses in the local model_calls.json audit (default true).
# false keeps only metadata, token usage and hashes. The API key is never stored.
# SCIFORGE_STORE_PROMPTS=true
# Sources sent to the model: "verified" (default) or "verified_or_partial" (explicit opt-in, labelled).
# SCIFORGE_MODEL_ELIGIBILITY=verified
# Reserved, no effect: semantic (model-based) claim checking is NOT implemented (default false).
# Only deterministic exact-quote, numeric-consistency and citation checks run.
# SCIFORGE_MODEL_ENTAILMENT=false
# Maximum characters of each abstract sent to the model (default 4000, range 200-50000; cut at a word boundary).
# SCIFORGE_MAX_SOURCE_CHARS=4000
# LOCAL DEBUGGING ONLY (default false): keep raw rejected model output in runs/<stamp>/debug/rejected_raw.json.
# Never set this for runs whose outputs you share; normal outputs never contain raw rejected output.
# SCIFORGE_DEBUG_KEEP_REJECTED_RAW=false

# ---------------------------------------------------------------------------
# Web app Live Mode (see docs/web-app.md). Deployment gate: exactly "true" enables Live Mode.
# SCIFORGE_LIVE_ENABLED=false
# Sign-in for Live Mode (default true; ONLY the exact value "false" disables it — anything else means true).
# When true, Live Mode needs Streamlit OIDC login ([auth] in .streamlit/secrets.toml + the Authlib package)
# and an allowlisted email. Demo Mode never needs sign-in.
# SCIFORGE_LIVE_REQUIRE_AUTH=true
# Comma-separated allowlist (case-insensitive exact match). Empty = nobody may use Live Mode (fail closed).
# SCIFORGE_LIVE_ALLOWED_EMAILS=
# Emergency off switch (default off). Unset, empty or exactly "false" = off; ANY other value = on
# (Live Mode unavailable regardless of every other setting).
# SCIFORGE_LIVE_KILL_SWITCH=false
# Per-user Live usage limit (sign-in required only): runs per rolling 24 h, integer 1-1000. Runs count when
# they start (failed runs count). The store keeps only a hash of the verified email + timestamps.
# SCIFORGE_LIVE_MAX_RUNS_PER_USER=3
# Absolute path of the quota store (default $XDG_STATE_HOME/sciforge/live_quota.json, else
# ~/.local/state/sciforge/live_quota.json).
# SCIFORGE_LIVE_QUOTA_PATH=/var/lib/sciforge/live_quota.json
# Optional secret for HMAC-SHA256 of the email (unset = plain SHA-256, guessable from candidate emails).
# SCIFORGE_LIVE_QUOTA_SALT=replace-with-a-long-random-string
# Quota backend: "file" (default, local JSON store) or "postgres" (shared DB via the Streamlit SQL connection
# [connections.<name>] in .streamlit/secrets.toml; DB credentials go ONLY there, never here). Apply
# deploy/sql/001_live_quota.sql first; the app never creates tables. Anything else = configuration error.
# SCIFORGE_LIVE_QUOTA_BACKEND=file
# SCIFORGE_LIVE_QUOTA_CONNECTION=sciforge_quota
